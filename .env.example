# Postgres connection. On Render + Neon, paste Neon's pooled connection string here.
DATABASE_URL=postgres://user:password@host/dbname
DB_SSL=true

# JWT signing secret \u2014 generate a long random string for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRY=8h

# Local dev port. Render sets PORT itself \u2014 don't hardcode it there.
PORT=3000
