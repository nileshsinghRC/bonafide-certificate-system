# Postgres connection. On Render + Neon, paste Neon's pooled connection string here.
DATABASE_URL=postgres://user:password@host/dbname
DB_SSL=true

# JWT signing secret — generate a long random string for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRY=8h

# Local dev port. Render sets PORT itself — don't hardcode it there.
PORT=3000

# Student account provisioning
# Restricts bulk-imported / SDMIS-synced student accounts to this email
# domain, e.g. "anu.edu.in". Leave blank to allow any well-formed email
# during initial rollout.
STUDENT_EMAIL_DOMAIN=

# Shared secret for the machine-to-machine SDMIS sync endpoint
# (POST /api/integrations/students/sync, header: X-API-Key). Generate one
# the same way as JWT_SECRET above. Leave unset to disable that endpoint.
INTEGRATION_API_KEY=

